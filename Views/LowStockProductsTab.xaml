<UserControl x:Class="HermesPOS.Views.LowStockProductsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <!-- 🔍 Αναζήτηση -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Αναζήτηση:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="300"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Button Content="📤 Εξαγωγή σε Excel"
                    Command="{Binding ExportToExcelCommand}"
                    Width="180"/>
        </StackPanel>

        <!-- DATAGRID -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredProducts}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Όνομα"
                                    Binding="{Binding Name}"
                                    Width="*" />

                <DataGridTextColumn Header="Barcode"
                                    Binding="{Binding Barcode}"
                                    Width="150" />

                <DataGridTextColumn Header="Απόθεμα"
                                    Binding="{Binding Stock}"
                                    Width="100" />

                <DataGridTextColumn Header="Προμηθευτής"
                                    Binding="{Binding Supplier.Name}"
                                    Width="150" />

                <DataGridTextColumn Header="Κατηγορία"
                                    Binding="{Binding Category.Name}"
                                    Width="150" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>