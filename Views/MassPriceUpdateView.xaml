<UserControl x:Class="HermesPOS.Views.MassPriceUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HermesPOS.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ΤΙΤΛΟΣ -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <TextBlock Text="ΜΑΖΙΚΗ ΕΝΗΜΕΡΩΣΗ ΤΙΜΩΝ"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ΦΙΛΤΡΑ -->
        <GroupBox Grid.Row="1"
                  Header="ΦΙΛΤΡΑ ΕΠΙΛΟΓΗΣ"
                  FontWeight="SemiBold"
                  Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Supplier -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Προμηθευτής"
                               FontWeight="SemiBold"/>

                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              DisplayMemberPath="Name"
                              Height="35"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Row="1"
                            Grid.Column="1">

                    <TextBlock Text="Κατηγορία"
                               FontWeight="SemiBold"/>

                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Height="35"/>
                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- ΡΥΘΜΙΣΕΙΣ ΕΝΗΜΕΡΩΣΗΣ -->
        <GroupBox Grid.Row="2"
          Header="ΡΥΘΜΙΣΕΙΣ ΕΝΗΜΕΡΩΣΗΣ"
          HorizontalAlignment="Center"
          Width="650"
          Margin="0,15,0,0"
          Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ΤΥΠΟΣ ΤΙΜΗΣ -->
                <StackPanel Grid.Column="0"
                    Margin="0,0,10,0">

                    <TextBlock Text="ΤΥΠΟΣ ΤΙΜΗΣ"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                    <ComboBox ItemsSource="{Binding PriceTypes}"
                      SelectedItem="{Binding SelectedPriceType}"
                      Height="35"/>
                </StackPanel>

                <!-- ΝΕΑ ΤΙΜΗ -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="ΝΕΑ ΤΙΜΗ"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                    <TextBox Text="{Binding Value}"
                     Height="35"
                     VerticalContentAlignment="Center"/>
                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- ΠΡΟΕΠΙΣΚΟΠΗΣΗ -->
        <GroupBox Grid.Row="3"
          Header="ΠΡΟΪΟΝΤΑ"
          Margin="0,15,0,0"
          Padding="5"
          HorizontalAlignment="Stretch">

            <Grid>

                <!-- ΛΙΑΝΙΚΗ -->
                <DataGrid ItemsSource="{Binding PreviewProducts}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnWidth="*"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Visibility="{Binding IsRetailSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" />
                        <DataGridTextColumn Header="ΠΡΟΪΟΝ" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="ΛΙΑΝΙΚΗ ΤΙΜΗ" Binding="{Binding Price}" />
                    </DataGrid.Columns>

                </DataGrid>

                <!-- ΧΟΝΔΡΙΚΗ -->
                <DataGrid ItemsSource="{Binding PreviewProducts}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnWidth="*"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Visibility="{Binding IsWholesaleSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" />
                        <DataGridTextColumn Header="ΠΡΟΪΟΝ" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="ΧΟΝΔΡΙΚΗ ΤΙΜΗ" Binding="{Binding WholesalePrice}" />
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </GroupBox>
        <!-- ΚΟΥΜΠΙΑ -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="ΕΦΑΡΜΟΓΗ ΑΛΛΑΓΩΝ"
        Command="{Binding ApplyCommand}"
        Width="180"
        Height="40"
        Margin="5"
        FontWeight="Bold"
        Background="#0078D7"
        Foreground="White"
        BorderBrush="#005A9E"
        BorderThickness="1"
        Cursor="Hand">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0063B1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004F8A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>